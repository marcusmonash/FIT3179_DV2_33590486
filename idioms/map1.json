{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where International Tourists Come From?",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "projection": {
    "type": "naturalEarth1"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6edf2",
        "stroke": "#b0bec5",
        "strokeWidth": 0.5
      }
    },
    {
      "data": { "url": "data/map1.csv" },
      "mark": {
        "type": "rule",
        "color": "#D55E00",
        "opacity": 0.85,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": { "field": "Origin_Lon", "type": "quantitative" },
        "latitude": { "field": "Origin_Lat", "type": "quantitative" },
        "longitude2": { "field": "Destination_Lon" },
        "latitude2": { "field": "Destination_Lat" },
        "strokeWidth": {
          "field": "Visitors",
          "type": "quantitative",
          "title": "Visitors",
          "scale": { "range": [1, 6] }
        },
        "tooltip": [
          { "field": "Origin", "type": "nominal", "title": "Origin Country" },
          {
            "field": "Destination",
            "type": "nominal",
            "title": "Gateway City"
          },
          {
            "field": "Visitors",
            "type": "quantitative",
            "title": "Visitors",
            "format": ",d"
          }
        ]
      }
    },
    {
      "data": { "url": "data/map1.csv" },
      "mark": { "type": "circle", "color": "#1f77b4", "size": 50 },
      "encoding": {
        "longitude": { "field": "Origin_Lon", "type": "quantitative" },
        "latitude": { "field": "Origin_Lat", "type": "quantitative" },
        "tooltip": [
          { "field": "Origin", "type": "nominal", "title": "Origin Country" }
        ]
      }
    }
  ]
}
