{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "10-Year Tourism Spending Analysis (2016-2025)",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 350,
  "data": { "url": "data/idiom6.csv" },
  "mark": { "type": "area", "interpolate": "monotone" },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "nominal",
      "title": "Year"
    },
    "y": {
      "field": "Spend_AUD_M",
      "type": "quantitative",
      "stack": "center",
      "title": "Expenditure Trend ($M)",
      "axis": null
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "title": "Spending Category",
      "scale": {
        "range": [
          "#0072B2",
          "#E69F00",
          "#56B4E9",
          "#D55E00",
          "#009E73",
          "#CC79A7"
        ]
      }
    },
    "tooltip": [
      { "field": "Year", "type": "nominal" },
      { "field": "Category", "type": "nominal", "title": "Spending Category" },
      {
        "field": "Spend_AUD_M",
        "type": "quantitative",
        "title": "Total Spending ($M AUD)",
        "format": ",.0f"
      }
    ]
  }
}
