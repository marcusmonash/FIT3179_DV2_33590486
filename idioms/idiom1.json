{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Long People Stay Vs Their Spendings (2025-2026)",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "data": { "url": "data/idiom1.csv" },
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 2 },
      "encoding": {
        "x": {
          "field": "Metric",
          "type": "nominal",
          "title": "Comparison",
          "scale": { "padding": 0.3 },
          "axis": {
            "labelAngle": 0,
            "titlePadding": 10
          }
        },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "title": "Value",
          "scale": { "type": "log" }
        },
        "color": {
          "field": "Reason",
          "type": "nominal",
          "title": "Visitor Category",
          "scale": {
            "range": [
              "#0072B2",
              "#E69F00",
              "#56B4E9",
              "#D55E00",
              "#009E73",
              "#CC79A7"
            ]
          }
        }
      }
    },
    {
      "mark": { "type": "point", "size": 80, "filled": true },
      "encoding": {
        "x": { "field": "Metric", "type": "nominal" },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "scale": { "type": "log" }
        },
        "color": { "field": "Reason", "type": "nominal" },
        "tooltip": [
          { "field": "Reason", "type": "nominal", "title": "Visitor Category" },
          { "field": "Metric", "type": "nominal" },
          {
            "field": "Value",
            "type": "quantitative",
            "title": "Value",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}
