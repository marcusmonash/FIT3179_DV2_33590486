{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Domestic vs International Spending",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "data": { "url": "data/idiom5.csv" },
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "Category",
      "type": "nominal",
      "title": "Expenses Category"
    },
    "x": {
      "field": "Spend_AUD_M",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Percentage (%)",
      "axis": { "format": "%" }
    },
    "color": {
      "field": "Visitor_Type",
      "type": "nominal",
      "title": "Visitor Type",
      "scale": { "range": ["#1f77b4", "#ff7f0e"] }
    },
    "tooltip": [
      { "field": "Visitor_Type", "type": "nominal", "title": "Type" },
      { "field": "Category", "type": "nominal" },
      {
        "field": "Spend_AUD_M",
        "type": "quantitative",
        "title": "Spend ($M)",
        "format": ",.1f"
      }
    ]
  }
}
