{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What Tourists Spend their Money On (2024-2025)",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 300,
  "data": { "url": "data/chart2.csv" },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Spend (AUD m)",
          "as": "Total_Category_Spending"
        }
      ],
      "groupby": ["Spending Category"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Total_Category_Spending",
          "as": "Grand_Total_Spending"
        }
      ]
    },
    {
      "calculate": "datum.Total_Category_Spending / datum.Grand_Total_Spending",
      "as": "Spending_Percentage"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 20,
        "outerRadius": 140,
        "stroke": "#fff"
      },
      "encoding": {
        "theta": {
          "field": "Total_Category_Spending",
          "type": "quantitative",
          "stack": true
        },
        "radius": {
          "field": "Total_Category_Spending",
          "type": "quantitative",
          "scale": { "type": "sqrt", "zero": true, "rangeMin": 20 }
        },
        "color": {
          "field": "Spending Category",
          "type": "nominal",
          "scale": {
            "range": [
              "#0072B2",
              "#E69F00",
              "#56B4E9",
              "#D55E00",
              "#009E73",
              "#CC79A7"
            ]
          }
        },
        "tooltip": [
          { "field": "Spending Category", "type": "nominal" },
          {
            "field": "Total_Category_Spending",
            "type": "quantitative",
            "title": "Total Spending ($M AUD)",
            "format": ",.0f"
          },
          {
            "field": "Spending_Percentage",
            "type": "quantitative",
            "title": "Spending Percentage (%)",
            "format": ".1%"
          }
        ]
      }
    }
  ]
}
