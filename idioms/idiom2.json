{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Transport Tourists Use",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "data": { "url": "data/idiom2.csv" },
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 2, "color": "#888" },
      "encoding": {
        "y": {
          "field": "Mode",
          "type": "nominal",
          "title": "Transport Type",
          "sort": "-x"
        },
        "x": {
          "field": "Spend_AUD_M",
          "type": "quantitative",
          "title": "Expenses ($M)"
        }
      }
    },
    {
      "mark": { "type": "point", "size": 120, "filled": true },
      "encoding": {
        "y": {
          "field": "Mode",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Spend_AUD_M",
          "type": "quantitative"
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "title": "Transit Type",
          "scale": { "scheme": "set2" }
        },
        "tooltip": [
          { "field": "Mode", "type": "nominal", "title": "Mode" },
          {
            "field": "Spend_AUD_M",
            "type": "quantitative",
            "title": "Expenses ($M)",
            "format": ",d"
          }
        ]
      }
    }
  ]
}
