{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Transport Tourists Use (2024-2025)",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "data": { "url": "data/idiom2.csv" },
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 2, "color": "#888" },
      "encoding": {
        "y": {
          "field": "Mode",
          "type": "nominal",
          "title": "Transport Category",
          "sort": "-x"
        },
        "x": {
          "field": "Spend_AUD_M",
          "type": "quantitative",
          "title": "Spending ($M AUD)"
        }
      }
    },
    {
      "mark": { "type": "point", "size": 120, "filled": true },
      "encoding": {
        "y": {
          "field": "Mode",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Spend_AUD_M",
          "type": "quantitative"
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "title": "Transit Category",
          "scale": {
            "range": [
              "#0072B2",
              "#E69F00",
              "#56B4E9",
              "#D55E00",
              "#009E73",
              "#CC79A7"
            ]
          }
        },
        "tooltip": [
          { "field": "Mode", "type": "nominal", "title": "Transport Type" },
          {
            "field": "Spend_AUD_M",
            "type": "quantitative",
            "title": "Spending ($M AUD)",
            "format": ",d"
          }
        ]
      }
    }
  ]
}
