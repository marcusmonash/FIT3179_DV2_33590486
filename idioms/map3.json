{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "International Visitor Spend by Source Country",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 380,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e2e8f0",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/map1.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#1e293b",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "Origin_Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Origin_Lat",
          "type": "quantitative"
        },
        "size": {
          "field": "Spend_AUD_M",
          "type": "quantitative",
          "title": "Total Spend ($M AUD)",
          "scale": {
            "range": [50, 800]
          }
        },
        "color": {
          "field": "Spend_AUD_M",
          "type": "quantitative",
          "title": "Spend ($M AUD)",
          "scale": {
            "scheme": "blues"
          }
        },
        "tooltip": [
          { "field": "Origin", "type": "nominal", "title": "Country" },
          {
            "field": "Spend_AUD_M",
            "type": "quantitative",
            "title": "Total Spend ($M AUD)",
            "format": "$,.1f"
          },
          {
            "field": "Visitors",
            "type": "quantitative",
            "title": "Total Visitors",
            "format": ",d"
          }
        ]
      }
    }
  ]
}