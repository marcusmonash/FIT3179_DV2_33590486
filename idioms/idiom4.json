{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State Spending Across Spending Categories (2024-2025)",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 300,
  "data": { "url": "data/chart2.csv" },
  "mark": { "type": "rect", "stroke": "#ffffff", "strokeWidth": 1 },
  "encoding": {
    "x": {
      "field": "Code",
      "type": "nominal",
      "title": "State / Territory"
    },
    "y": {
      "field": "Spending Category",
      "type": "nominal",
      "title": "Spending Category"
    },
    "color": {
      "field": "Spend (AUD m)",
      "type": "quantitative",
      "title": "Spending ($M)",
      "scale": { "scheme": "blues" }
    },
    "tooltip": [
      { "field": "State", "type": "nominal" },
      { "field": "Spending Category", "type": "nominal" },
      {
        "field": "Spend (AUD m)",
        "type": "quantitative",
        "title": "Spending ($M AUD)",
        "format": ",.0f"
      }
    ]
  }
}
